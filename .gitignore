# Environment — never commit real keys
.env
.env.local
.env.*.local

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
*.egg-info/
dist/
build/
.hypothesis/

# Sessions — FAISS vectorstores and chunks are large binary/JSON files
# They are regenerated on first use, no need to commit
sessions/

# Vector store (legacy path)
vectorstore/

# Frontend build output — generated by Docker, not source code
frontend/dist/
frontend/node_modules/

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Evaluation results — optional, can be regenerated
evaluation_results.json
